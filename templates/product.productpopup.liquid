<div class="popup-product">
  <img src="{{ product.featured_image | img_url: '400x400' }}" alt="{{ product.title }}">
  <h2>{{ product.title }}</h2>
  <p class="price">{{ product.price | money }}</p>
  <p class="description">{{ product.description | strip_html | truncatewords: 25 }}</p>

  <form class="popup-cart-form">
    <select class="popup-variants" name="id">
      {% for variant in product.variants %}
        <option value="{{ variant.id }}" data-options="{{ variant.title }}">
          {{ variant.title }} - {{ variant.price | money }}
        </option>
      {% endfor %}
    </select>
    <button type="submit" class="popup-add-to-cart">Add to Cart →</button>
  </form>
</div>
