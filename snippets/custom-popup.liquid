<!-- QUICK VIEW POPUP -->
<div class="product-popup">
  <div class="product-popup-overlay"></div>
  <div class="product-popup-box">
    <button class="popup-close">&times;</button>
    <div class="product-popup-content"></div>
  </div>
</div>

<style>
/* === POPUP BASE === */
.product-popup { 
  position: fixed; inset: 0; display: none; 
  align-items: center; justify-content: center; z-index: 9999; 
}
.product-popup.active { display: flex; }
.product-popup-overlay { 
  position: absolute; inset: 0; background: rgba(0,0,0,0.55); 
}
.product-popup-box {
  position: relative; background: #fff; padding: 24px;
  max-width: 480px; width: 100%; border-radius: 14px; z-index: 10000;
  box-shadow: 0 10px 35px rgba(0,0,0,0.25);
  font-family: Arial, sans-serif;
}
.popup-close {
  position: absolute; top: 14px; right: 16px;
  background: none; border: none; font-size: 26px; cursor: pointer;
}

/* === POPUP CONTENT === */
.product-popup-content img {
  width: 100%; border-radius: 10px; margin-bottom: 16px;
}
.product-popup-content h2 { font-size: 22px; font-weight: 600; margin-bottom: 6px; }
.product-popup-content .price { font-size: 20px; font-weight: 700; margin-bottom: 10px; }
.product-popup-content .description { font-size: 14px; color: #555; margin-bottom: 18px; }

.variant-group { margin-bottom: 16px; }
.variant-group label { display: block; font-weight: 600; margin-bottom: 6px; }
.variant-colors { display: flex; gap: 12px; }
.variant-colors button {
  padding: 8px 20px; border: 1px solid #bbb; cursor: pointer;
  border-radius: 6px; background: #fff; transition: 0.2s;
}
.variant-colors button.active { border: 2px solid #000; background: #f9f9f9; }
.variant-dropdown { width: 100%; padding: 12px; border-radius: 6px; border: 1px solid #ccc; }

/* === BUTTONS === */
.popup-add-to-cart,
.quick-view-btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: 8px;
  width: 100%; padding: 14px;
  background: black; color: white; font-size: 15px; font-weight: 600;
  border: none; cursor: pointer; border-radius: 8px;
  text-transform: uppercase; letter-spacing: 0.5px;
  transition: all 0.25s ease;
  position: relative;
}
.popup-add-to-cart::after,
.quick-view-btn::after {
  content: "→";
  font-size: 16px;
  margin-left: 6px;
  transition: transform 0.2s ease;
}
.popup-add-to-cart:hover::after,
.quick-view-btn:hover::after {
  transform: translateX(4px);
}
.popup-add-to-cart:hover,
.quick-view-btn:hover { background: #333; }
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const popup = document.querySelector(".product-popup");
  const popupContent = popup.querySelector(".product-popup-content");
  const closeBtn = popup.querySelector(".popup-close");

  // Open popup
  document.querySelectorAll(".quick-view-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const handle = btn.getAttribute("data-handle");
      fetch(`/products/${handle}.js`)
        .then(res => res.json())
        .then(product => {
          let colorOptions = "";
          let sizeOptions = "";

          product.options.forEach(opt => {
            if (opt.name.toLowerCase() === "color") {
              colorOptions = `
                <div class="variant-group">
                  <label>${opt.name}</label>
                  <div class="variant-colors">
                    ${opt.values.map(val => 
                      `<button type="button" class="color-btn" data-value="${val}">${val}</button>`
                    ).join("")}
                  </div>
                </div>`;
            } else {
              sizeOptions = `
                <div class="variant-group">
                  <label>${opt.name}</label>
                  <select class="variant-dropdown" data-option="${opt.name}">
                    <option value="">Choose your ${opt.name}</option>
                    ${opt.values.map(val => `<option value="${val}">${val}</option>`).join("")}
                  </select>
                </div>`;
            }
          });

          popupContent.innerHTML = `
            <img src="${product.images[0]}" alt="${product.title}">
            <h2>${product.title}</h2>
            <p class="price">₹${(product.price/100).toFixed(2)}</p>
            <p class="description">${product.description}</p>
            <form class="popup-cart-form">
              ${colorOptions}
              ${sizeOptions}
              <button type="submit" class="popup-add-to-cart">Add to Cart</button>
            </form>
          `;

          let selectedColor = null;
          popupContent.querySelectorAll(".color-btn").forEach(btn => {
            btn.addEventListener("click", () => {
              popupContent.querySelectorAll(".color-btn").forEach(b => b.classList.remove("active"));
              btn.classList.add("active");
              selectedColor = btn.dataset.value;
            });
          });

          // Add to cart
          const form = popupContent.querySelector(".popup-cart-form");
          form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const sizeSelect = form.querySelector(".variant-dropdown");
            const selectedSize = sizeSelect ? sizeSelect.value : null;

            const chosenVariant = product.variants.find(v => {
              return (!selectedColor || v.title.toLowerCase().includes(selectedColor.toLowerCase())) &&
                     (!selectedSize || v.title.toLowerCase().includes(selectedSize.toLowerCase()));
            });

            if (!chosenVariant) {
              alert("Please select all options.");
              return;
            }

            try {
              await fetch("/cart/add.js", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id: chosenVariant.id, quantity: 1 })
              });

              // Update cart count without refresh
              const cartRes = await fetch("/cart.js");
              const cart = await cartRes.json();
              const cartCount = document.querySelector(".cart-count"); // <- add this span in header
              if (cartCount) cartCount.textContent = cart.item_count;

              alert("Added to cart!");
            } catch (err) {
              console.error(err);
              alert("Error adding to cart!");
            }
          });

          popup.classList.add("active");
        });
    });
  });

  // Close
  closeBtn.addEventListener("click", () => popup.classList.remove("active"));
  popup.querySelector(".product-popup-overlay").addEventListener("click", () => popup.classList.remove("active"));
});
</script>
