<div id="quickViewPopup" class="popup-overlay hidden">
  <div class="popup-content">
    <span class="popup-close" role="button" aria-label="Close popup">&times;</span>
    
    <!-- Product Image -->
    {{ 'product-1' | placeholder_svg_tag: 'popup-placeholder' }}

    <!-- Product Title -->
    <h3 id="popupProductTitle" style="margin-bottom:10px;">Product Title</h3>

    <!-- Product Price -->
    <p id="popupProductPrice" style="margin-bottom:15px;">₹0.00</p>

    <!-- Product Description -->
    <div id="popupProductDescription" style="margin-bottom:20px;">
      Product description goes here.
    </div>

    <!-- View Product Button -->
    <a id="popupProductLink" href="#" class="popup-button">
      View Product
    </a>
  </div>
</div>
