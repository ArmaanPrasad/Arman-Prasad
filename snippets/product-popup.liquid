<div class="popup-overlay" onclick="closeProductPopup()"></div>
<div class="popup-product">
  <div class="popup-left">
    {% if product.featured_image %}
      <img 
        src="{{ product.featured_image | image_url: '600x' }}" 
        alt="{{ product.title }}" 
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
        class="popup-product-image">
    {% endif %}
  </div>

  <div class="popup-right">
    <h2 class="popup-product-title">{{ product.title }}</h2>
    <p class="popup-product-price">{{ product.price | money }}</p>

    {% if product.description != blank %}
      <div class="popup-product-description">
        {{ product.description | strip_html | truncate: 300 }}
      </div>
    {% endif %}

    <form method="post" action="{{ routes.cart_add_url }}" class="popup-add-to-cart">
      <input type="hidden" name="id" value="{{ product.variants.first.id }}">
      <button type="submit" class="popup-add-btn">Add to Cart</button>
    </form>
  </div>
</div>

<style>
.popup-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.5);
  z-index: 999;
}
.popup-product {
  position: fixed;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  padding: 24px;
  border-radius: 10px;
  max-width: 800px;
  width: 90%;
  z-index: 1000;
}
.popup-left img {
  width: 100%;
  border-radius: 8px;
}
.popup-right {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.popup-product-title {
  font-size: 28px;
  font-weight: 700;
}
.popup-product-price {
  font-size: 20px;
  font-weight: 600;
  color: #e63946;
}
.popup-product-description {
  font-size: 14px;
  color: #555;
}
.popup-add-btn {
  padding: 12px 24px;
  background: black;
  color: white;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  transition: 0.3s;
}
.popup-add-btn:hover {
  background: #333;
}
</style>

<script>
function closeProductPopup() {
  document.getElementById('popup-container').innerHTML = '';
  document.getElementById('popup-container').classList.add('popup-hidden');
}
</script>
