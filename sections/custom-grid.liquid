<section class="custom-grid">
  <div class="grid-inner">
    {% for product in collections.all.products limit: 12 %}
      <div class="grid-item">
        <a href="{{ product.url }}" class="grid-link">
          {% if product.featured_image %}
            <img 
              src="{{ product.featured_image | image_url: '600x600' }}" 
              alt="{{ product.title }}" 
              class="grid-image"
              loading="lazy">
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'grid-image-placeholder' }}
          {% endif %}
          <h3 class="grid-title">{{ product.title }}</h3>
          <p class="grid-price">{{ product.price | money }}</p>
        </a>
      </div>
    {% endfor %}
  </div>
</section>

<style>
.custom-grid {
  padding: 60px 40px;
  max-width: 1400px;
  margin: 0 auto;
}

.grid-inner {
  display: grid;
  grid-template-columns: repeat(2, 1fr); /* 🔹 Always 2 columns */
  gap: 30px;
}

.grid-item {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 14px rgba(0,0,0,0.08);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.grid-item:hover {
  transform: translateY(-6px);
  box-shadow: 0 8px 22px rgba(0,0,0,0.15);
}

.grid-link {
  text-decoration: none;
  display: block;
  color: inherit;
}

.grid-image {
  width: 100%;
  height: 300px;
  object-fit: cover;
  border-bottom: 1px solid #eee;
  display: block;
}

.grid-title {
  font-size: 1.25rem;
  font-weight: 600;
  margin: 16px;
  color: #111;
}

.grid-price {
  font-size: 1rem;
  font-weight: 500;
  color: #333;
  margin: 0 16px 20px;
}

/* 🔹 Adjust sizes for smaller screens */
@media (max-width: 768px) {
  .custom-grid {
    padding: 40px 20px;
  }
  .grid-image {
    height: 240px;
  }
  .grid-title {
    font-size: 1.1rem;
  }
  .grid-price {
    font-size: 0.95rem;
  }
}
</style>

{% schema %}
{
  "name": "Custom Grid",
  "tag": "section",
  "class": "section-custom-grid",
  "settings": [],
  "presets": [
    {
      "name": "Custom Grid",
      "category": "Custom"
    }
  ]
}
{% endschema %}
