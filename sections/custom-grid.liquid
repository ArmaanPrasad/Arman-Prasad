{{ 'custom-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-grid.js' | asset_url }}" defer="defer"></script>

<section class="custom-grid">
  <div class="grid-inner">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      {% if product != blank %}
        <div class="grid-item" data-handle="{{ product.handle }}">
          {% if product.featured_image %}
            <img 
              src="{{ product.featured_image | img_url: '500x' }}" 
              alt="{{ product.title | escape }}" 
              width="{{ product.featured_image.width }}" 
              height="{{ product.featured_image.height }}">
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
          <h3>{{ product.title }}</h3>
          <p>{{ product.price | money }}</p>
          <button class="quick-view-btn" data-handle="{{ product.handle }}">Quick View</button>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <!-- Instead of inline popup, render the snippet -->
  {% render 'custom-popup' %}
</section>

{% schema %}
{
  "name": "Custom Product Grid",
  "tag": "section",
  "class": "section-custom-grid",
  "settings": [],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid",
      "category": "Custom",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
