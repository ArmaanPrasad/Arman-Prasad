<section class="custom-grid">
  <div class="grid-inner">
    {% if section.settings.collection != blank %}
      <div class="product-grid">
        {% for product in collections[section.settings.collection].products %}
          <div class="product-card">
            <a href="{{ product.url }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: '400x' }}" alt="{{ product.title }}">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
              <h3>{{ product.title }}</h3>
              <p>{{ product.price | money }}</p>
            </a>
          </div>
        {% else %}
          <p>No products found in this collection.</p>
        {% endfor %}
      </div>
    {% else %}
      <p>Please select a collection in the section settings.</p>
    {% endif %}
  </div>
</section>

<style>
.custom-grid .product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px,1fr));
  gap: 20px;
}
.product-card {
  border: 1px solid #ddd;
  border-radius: 10px;
  padding: 15px;
  text-align: center;
  transition: all .3s ease;
}
.product-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 5px 15px rgba(0,0,0,0.15);
}
.product-card img {
  max-width: 100%; height: auto; margin-bottom: 10px;
}
.product-card h3 { font-size: 16px; font-weight: bold; }
.product-card p { font-size: 14px; color: #555; }
</style>

{% schema %}
{
  "name": "Custom Product Grid",
  "tag": "section",
  "class": "section-custom-grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid",
      "category": "Custom"
    }
  ]
}
{% endschema %}
