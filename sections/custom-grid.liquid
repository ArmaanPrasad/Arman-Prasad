<div class="custom-grid">
  {% for block in section.blocks %}
    {% if block.settings.product != blank %}
      {% assign product = all_products[block.settings.product] %}
      <div class="grid-item">
        <img 
          src="{{ product.featured_image | image_url: width: 400 }}" 
          alt="{{ product.title }}" 
          width="400" height="400">
        <h3>{{ product.title }}</h3>
        <p>{{ product.price | money }}</p>
        <button class="quick-view-btn" data-handle="{{ product.handle }}">Quick View</button>
      </div>
    {% endif %}
  {% endfor %}
</div>

{% render 'product-popup' %}

<style>
.custom-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 24px;
}
.grid-item {
  border: 1px solid #eee;
  padding: 16px;
  text-align: center;
  border-radius: 8px;
  background: #fafafa;
}
.grid-item img { width:100%; border-radius:8px; margin-bottom:12px; }
.grid-item h3 { font-size: 18px; margin-bottom: 8px; }
.grid-item p { font-weight: 600; color: #333; }
.quick-view-btn {
  padding: 8px 16px;
  border: none;
  background: black;
  color: white;
  border-radius: 6px;
  cursor: pointer;
}
.quick-view-btn:hover { background: #333; }
@media(max-width:768px){
  .custom-grid { grid-template-columns: 1fr 1fr; }
}
</style>

{% schema %}
{
  "name": "Custom Grid",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
