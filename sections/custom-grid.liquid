{% comment %}
Custom Grid Section
- Merchant can select up to 6 products
- Displays product image, title, price
- Clicking a product can trigger popup (wired via JS)
{% endcomment %}

<section class="custom-grid">
  <div class="grid-container">
    {% for block in section.blocks %}
      {% assign product = all_products[block.settings.product] %}
      {% if product %}
        <div class="grid-item" data-handle="{{ product.handle }}">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}">
          {% elsif product.images and product.images.size > 0 %}
            <img src="{{ product.images[0] | image_url: width: 400 }}" alt="{{ product.title }}">
          {% else %}
            <img src="{{ 'placeholder-image.png' | asset_url }}" alt="No image available">
          {% endif %}

          <h3>{{ product.title }}</h3>
          <p>{{ product.price | money }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {%- render 'custom-popup' -%}
</section>

<style>
  .custom-grid .grid-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .grid-item {
    cursor: pointer;
    padding: 15px;
    border: 1px solid #eee;
    border-radius: 10px;
    text-align: center;
    transition: all 0.2s ease;
  }
  .grid-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 10px rgba(0,0,0,.08);
  }
  @media(max-width: 768px) {
    .custom-grid .grid-container { grid-template-columns: 1fr 1fr; }
  }
  @media(max-width: 480px) {
    .custom-grid .grid-container { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Custom Product Grid",
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Custom Grid",
      "category": "Products"
    }
  ]
}
{% endschema %}
