{% comment %}
Custom Banner Section
- All text fields editable in customizer
- Includes button with hover animation
- Mobile responsive
{% endcomment %}

<section class="custom-banner">
  <div class="banner-content">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    <a href="{{ section.settings.button_link }}" class="banner-btn">
      {{ section.settings.button_text }}
    </a>
  </div>
</section>

<style>
  .custom-banner {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 80px 20px;
    background: {{ section.settings.bg_color }};
    text-align: center;
  }

  .custom-banner h1 {
    font-size: 3rem;
    margin-bottom: 20px;
  }

  .custom-banner p {
    font-size: 1.25rem;
    margin-bottom: 30px;
  }

  .banner-btn {
    padding: 12px 24px;
    background: {{ section.settings.button_color }};
    color: #fff;
    font-weight: bold;
    border-radius: 6px;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .banner-btn:hover {
    transform: scale(1.05);
    background: {{ section.settings.button_hover }};
  }

  @media(max-width: 768px) {
    .custom-banner h1 { font-size: 2rem; }
    .custom-banner p { font-size: 1rem; }
  }
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Heading Here" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Your subheading text here" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button Link" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#f8f8f8" },
    { "type": "color", "id": "button_color", "label": "Button Color", "default": "#000" },
    { "type": "color", "id": "button_hover", "label": "Button Hover Color", "default": "#333" }
  ],
  "presets": [
    { "name": "Custom Banner" }
  ]
}
{% endschema %}
