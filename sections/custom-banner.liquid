{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Heading",
      "default": "Welcome to Our Store"
    },
    {
      "type": "text",
      "id": "banner_subheading",
      "label": "Subheading",
      "default": "Best Products Await You"
    },
    {
      "type": "textarea",
      "id": "banner_text",
      "label": "Description",
      "default": "Shop the latest collections and offers now."
    },
    {
      "type": "text",
      "id": "banner_button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "banner_button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}

<section class="custom-banner">
  {% if section.settings.banner_image %}
    <img 
      src="{{ section.settings.banner_image | image_url: width: 1600 }}" 
      alt="{{ section.settings.banner_heading | escape }}"
      width="1600"
      height="600"
      class="banner-image"
    >
  {% endif %}

  <div class="banner-content">
    <h1 class="banner-heading">{{ section.settings.banner_heading }}</h1>
    <h3 class="banner-subheading">{{ section.settings.banner_subheading }}</h3>
    <p class="banner-text">{{ section.settings.banner_text }}</p>
    {% if section.settings.banner_button_text != blank %}
      <a href="{{ section.settings.banner_button_link }}" class="banner-button">
        {{ section.settings.banner_button_text }}
      </a>
    {% endif %}
  </div>
</section>

<style>
.custom-banner {
  position: relative;
  text-align: center;
  color: white;
}
.custom-banner .banner-image {
  width: 100%;
  height: auto;
  display: block;
}
.custom-banner .banner-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}
.banner-heading {
  font-size: 3rem;
  margin-bottom: 10px;
}
.banner-subheading {
  font-size: 1.5rem;
  margin-bottom: 10px;
}
.banner-text {
  font-size: 1rem;
  margin-bottom: 20px;
}
.banner-button {
  background: #e63946;
  color: white;
  padding: 12px 28px;
  border-radius: 30px;
  text-decoration: none;
  transition: all 0.3s ease;
  font-weight: bold;
}
.banner-button:hover {
  background: #d62828;
  transform: scale(1.05);
}
</style>
