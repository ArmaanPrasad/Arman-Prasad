{% comment %}
Custom Banner (from scratch)
- Editable texts + 2 buttons with simple animation
- Mobile responsive
- No Dawn components used
{% endcomment %}

<section class="c-banner section-{{ section.id }}">
  {%- if section.settings.bg_image != blank -%}
    <div class="c-banner__bg">
      <img
        srcset="{{ section.settings.bg_image | image_url: width: 800 }} 800w,
                {{ section.settings.bg_image | image_url: width: 1200 }} 1200w,
                {{ section.settings.bg_image | image_url: width: 1600 }} 1600w"
        sizes="(max-width: 768px) 100vw, 1600px"
        src="{{ section.settings.bg_image | image_url: width: 1600 }}"
        alt="{{ section.settings.bg_image.alt | escape }}"
        loading="lazy"
      >
    </div>
  {%- endif -%}

  <div class="c-banner__inner">
    {%- if section.settings.kicker != blank -%}
      <p class="c-banner__kicker">{{ section.settings.kicker }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="c-banner__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="c-banner__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="c-banner__actions">
      {%- if section.settings.primary_label != blank -%}
        <a class="c-btn c-btn--primary js-bounce"
           href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a class="c-btn c-btn--secondary js-bounce"
           href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
.section-{{ section.id }}{position:relative;overflow:hidden}
.section-{{ section.id }} .c-banner__bg{position:absolute;inset:0;z-index:-1}
.section-{{ section.id }} .c-banner__bg img{width:100%;height:100%;object-fit:cover}
.section-{{ section.id }} .c-banner__inner{max-width:1100px;margin:0 auto;padding:clamp(40px,6vw,120px) 16px;text-align:center}
.section-{{ section.id }} .c-banner__kicker{letter-spacing:.12em;text-transform:uppercase;font-size:.85rem;margin:0 0 .4rem}
.section-{{ section.id }} .c-banner__heading{font-size:clamp(28px,5vw,56px);line-height:1.1;margin:.25rem 0}
.section-{{ section.id }} .c-banner__sub{font-size:clamp(14px,2.3vw,18px);opacity:.8;max-width:70ch;margin:.75rem auto}
.section-{{ section.id }} .c-banner__actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:1.25rem}
.section-{{ section.id }} .c-btn{display:inline-block;padding:.9rem 1.25rem;border-radius:999px;border:2px solid currentColor;text-decoration:none;font-weight:600}
.section-{{ section.id }} .c-btn--primary{background:#111;color:#fff}
.section-{{ section.id }} .c-btn--secondary{background:transparent;color:#111}
@media (prefers-reduced-motion:no-preference){
  .section-{{ section.id }} .js-bounce{transition:transform .18s ease, box-shadow .18s ease}
  .section-{{ section.id }} .js-bounce:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.12)}
  .section-{{ section.id }} .js-bounce:active{transform:translateY(0)}
}
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "New arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Heading Here" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Your subheading text here" },

    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop Now" },
    { "type": "url",  "id": "primary_link",  "label": "Primary button link" },

    { "type": "text", "id": "secondary_label", "label": "Secondary button label" },
    { "type": "url",  "id": "secondary_link",  "label": "Secondary button link" }
  ],
  "presets": [
    { "name": "Custom Banner", "category": "Custom" }
  ]
}
{% endschema %}
