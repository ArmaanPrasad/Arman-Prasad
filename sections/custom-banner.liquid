{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Discover Joy: Your Ultimate Holiday Gift Destination." },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ]
}
{% endschema %}

<section class="custom-banner">
  <div class="banner-content">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subtext }}</p>
    <a href="{{ section.settings.button_link }}" class="banner-btn">{{ section.settings.button_label }}</a>
  </div>
</section>

<style>
.custom-banner {
  padding: 80px 20px;
  text-align: center;
  background: #f2f6fb;
}
.custom-banner h1 { font-size: 48px; margin-bottom: 15px; }
.custom-banner p { font-size: 18px; margin-bottom: 25px; }
.banner-btn {
  display: inline-block;
  padding: 12px 30px;
  background: #000;
  color: #fff;
  border-radius: 30px;
  transition: transform 0.3s ease, background 0.3s ease;
}
.banner-btn:hover {
  background: #444;
  transform: scale(1.05);
}
</style>
